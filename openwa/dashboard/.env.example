# =============================================================================
# OpenWA Dashboard (Vite) — environment example
# =============================================================================
# Copy to ".env.local" for local overrides, or set these in your host
# (e.g. Vercel → Project → Settings → Environment Variables).
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# These values are PUBLIC (baked into the built JS) — never put secrets here.
# =============================================================================

# Absolute base URL of your OpenWA backend API, INCLUDING the /api path.
# Required in production (Vercel) because the frontend and backend are on
# different hosts. The backend must run on a persistent host (VPS / Railway /
# Render / Fly.io) — NOT on Vercel.
VITE_API_URL=https://your-openwa-backend.example.com/api

# Optional: explicit Socket.IO origin for live updates (sessions/QR/messages).
# If omitted, it is derived from VITE_API_URL's origin automatically.
# VITE_WS_URL=https://your-openwa-backend.example.com

# -----------------------------------------------------------------------------
# Local development:
#   Leave BOTH unset (do not create a .env file) and run `npm run dev`.
#   The app falls back to "/api" and the Vite dev proxy forwards it to the
#   backend at http://localhost:2785 (see vite.config.ts).
# -----------------------------------------------------------------------------
