# =============================================================================
# OpenWA BACKEND — production environment example
# =============================================================================
# Copy to ".env.production" on your server and fill in real values:
#     cp .env.production.example .env.production
# Then start with:
#     docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# SECURITY: never commit the real .env.production. It is gitignored.
# This file contains SAFE PLACEHOLDERS ONLY — no real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=production                 # production => a strong random API key is seeded
                                    # (dev would seed the insecure "dev-admin-key")
PORT=2785                           # API listen port (Railway/Render inject their own PORT)
LOG_LEVEL=info                      # error | warn | info | debug
ENABLE_SWAGGER=false                # set true only if you want public API docs at /api/docs

# Disable the app's internal container orchestration (not needed for a plain backend).
DASHBOARD_ENABLED=false
PROXY_ENABLED=false

# ---------------------------------------------------------------------------
# CORS — REQUIRED so the Vercel dashboard can call this API from the browser.
# Comma-separated, EXACT origins (scheme + host, no trailing slash, no path).
# Put your Vercel production domain here (and any custom/preview domains you use).
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://your-dashboard.vercel.app
# Special value: set CORS_ORIGINS=off to DISABLE the app's own CORS headers when a
# reverse proxy / gateway in front already adds them (prevents duplicate
# Access-Control-Allow-Origin headers, which browsers reject). For a normal direct
# deployment (e.g. Caddy reverse_proxy, which does NOT add CORS), keep the real origin.

# ---------------------------------------------------------------------------
# Reverse proxy / HTTPS (used by docker-compose.prod.yml's bundled Caddy)
# ---------------------------------------------------------------------------
OPENWA_DOMAIN=api.yourdomain.com    # public DNS name that points at this server
ACME_EMAIL=admin@yourdomain.com     # email for Let's Encrypt certificate notices
# Public base URL of this backend (used in the startup banner / external links)
BASE_URL=https://api.yourdomain.com

# ---------------------------------------------------------------------------
# Database — SQLite by default (zero external services).
# Paths are ABSOLUTE inside the container and live on the persistent volume.
# ---------------------------------------------------------------------------
DATABASE_TYPE=sqlite
DATABASE_NAME=/app/data/openwa.sqlite
DATABASE_SYNCHRONIZE=true           # SQLite: keep true so tables auto-create on first boot

# --- Optional PostgreSQL instead of SQLite (uncomment + use the postgres profile) ---
# DATABASE_TYPE=postgres
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=openwa
# DATABASE_USERNAME=openwa
# DATABASE_PASSWORD=change-me-strong-password
# DATABASE_SYNCHRONIZE=false        # use migrations in production with Postgres

# ---------------------------------------------------------------------------
# WhatsApp engine (whatsapp-web.js + Chromium)
# ---------------------------------------------------------------------------
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=/app/data/sessions    # WhatsApp auth + browser profile/cache (persist!)
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium   # Chromium baked into the Docker image
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# ---------------------------------------------------------------------------
# Storage (uploads / media)
# ---------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media

# --- Optional S3/MinIO instead of local disk ---
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://s3.yourprovider.com
# S3_REGION=us-east-1
# S3_BUCKET=openwa
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ---------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------
PLUGINS_ENABLED=true
PLUGINS_DIR=/app/data/plugins

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Redis (optional; disabled by default)
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
# REDIS_HOST=redis
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# This build seeds its admin API key in the database on first boot and writes the
# raw value to /app/data/.api-key (read it with: docker compose ... exec api cat /app/data/.api-key).
# API_MASTER_KEY is NOT used by this version's auth — leave empty.
API_MASTER_KEY=
