# Root-level safety net (OpenWA lives in openwa/, which has its own .gitignore)

# Secrets / env
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.staging
.env
# ...but keep committed example templates
!**/.env.example
!**/.env.production.example
!**/.env.minimal

# Dependencies & build output
**/node_modules/
**/dist/
**/build/

# OpenWA runtime data (DBs, sessions, media, API keys, generated config)
openwa/data/
openwa/openwa
**/*.sqlite
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db
**/.api-key
**/.env.generated

# WhatsApp engine / browser auth & cache
**/.wwebjs_auth/
**/.wwebjs_cache/
**/sessions/session-*/

# Exported QR images
**/qr*.png

# Ad-hoc screenshots / screen captures
screencapture-*.png
**/screencapture-*.png

# Logs
**/*.log
logs/
