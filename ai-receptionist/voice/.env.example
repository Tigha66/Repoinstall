# Copy to .env and fill in. Required for live calls: OPENAI_API_KEY, TELNYX_API_KEY, PUBLIC_WSS_URL.
PORT=5050

# OpenAI Realtime (voice brain)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
VOICE=alloy

# Telnyx (answers calls + streams audio)
TELNYX_API_KEY=KEYxxxxxxxx

# Public, TLS WebSocket URL Telnyx connects to for media (must be wss:// and reachable from the internet)
PUBLIC_WSS_URL=wss://voice.callpilotvoice.co.uk/media

# Receptionist persona
BUSINESS_NAME=Bright Smile Dental
AGENT_NAME=Aria
HOURS=Mon–Sat, 9am–6pm

# Booking confirmation (reuses RingBack to send WhatsApp/SMS)
CONFIRM_URL=https://get.callpilotvoice.co.uk/api/book
