# ── Missed-Call Text-Back config ───────────────────────────────────────────

# Port this webhook service listens on (Telnyx + /simulate hit this)
PORT=2789

# OpenWA API
OPENWA_API_BASE=http://localhost:2785/api
OPENWA_API_KEY=owa_k1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The WhatsApp session NAME you connected in the dashboard (not the UUID)
OPENWA_SESSION=demo

# Branding used in the text-back ({business} is substituted into the message)
BUSINESS_NAME=Acme Barbers
TEXTBACK_MESSAGE=Hi! 👋 Sorry we missed your call to {business}. How can we help? Just reply here and we'll get right back to you.

# Optional: shared secret in the webhook path  ->  POST /telnyx/<token>
# Leave blank to accept POST /telnyx
WEBHOOK_TOKEN=

# Don't re-text the same number within this many ms (default 5 min)
COOLDOWN_MS=300000
